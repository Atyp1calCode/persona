# LLM — choose one backend

# Option A: Ollama (local, no API key needed)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Option B: OpenRouter (cloud)
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Sampling for the persona chat (fact extraction always runs at temperature 0).
# Tuned for roleplay on thedrummer/cydonia-24b-v4.1 (Mistral Small 3.2 base): a moderate
# temperature keeps the character consistent, min_p trims the low-probability tail that
# causes drift, and a light repetition penalty curbs loops — above ~1.1 it starts mangling
# names and recurring phrases. Leave unset to use the provider's defaults.
# Note: min_p is OpenRouter-provider dependent (Cydonia's current provider, Parasail, ignores
# it) and Ollama's OpenAI-compatible endpoint ignores both min_p and repetition penalty.
LLM_TEMPERATURE=0.8
LLM_MIN_P=0.05
LLM_REPETITION_PENALTY=1.05

# Embeddings
# When using Ollama, defaults to Ollama (nomic-embed-text) — no extra config needed.
# When using OpenRouter, defaults to OpenAI embeddings API (text-embedding-3-small).
# OPENAI_API_KEY=your-openai-key-here

# Override embedding service entirely (any OpenAI-compatible endpoint):
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=your-key-here
# EMBED_MODEL=text-embedding-3-small

# Retrieval
# Cosine distance cutoff for recalled past exchanges (0 = identical, 2 = opposite).
# Model-dependent: 0.8 suits text-embedding-3-small; tune if you switch embedding models.
# RELEVANCE_MAX_DISTANCE=0.8

# Chatbot
SYSTEM_PROMPT=You are a helpful assistant.

# Storage
LANCEDB_PATH=./data/lancedb

# Web server
PORT=3000
# Bind address. Loopback by default; the web API is unauthenticated, so only expose it
# (HOST=0.0.0.0) behind your own auth/reverse proxy.
# HOST=127.0.0.1

# Telegram (only needed for telegram mode)
# TELEGRAM_BOT_TOKEN=your-token-here
# TELEGRAM_ALLOWED_IDS=123456789,987654321
# Group chats: to let the bot respond in a group, add the group's (negative) chat id to
# TELEGRAM_ALLOWED_IDS. In groups the bot only replies when @mentioned or replied to; other
# messages are silently remembered. NOTE: to receive un-tagged group messages at all, disable
# privacy mode via BotFather (/setprivacy) or make the bot a group admin, then re-add it.
# Per-user notes injected as context when that user talks to the bot in a group.
# JSON array of { userId, notes } where notes is a string or array of strings:
# TELEGRAM_USER_NOTES=[{"userId":123456789,"notes":["Prefers to be called Alex","My neighbour"]}]
# Per-group character: personality traits the bot plays in that group, layered onto the
# system prompt. Groups do NOT see the global lore added via the web UI (that stays private),
# and facts the bot learns in a group stay scoped to that group.
# JSON array of { chatId, lore } where lore is a string or array of strings:
# TELEGRAM_GROUP_LORE=[{"chatId":-1001234567890,"lore":["You are Annabel","Sharp-tongued but warm underneath"]}]
# Group "thinking…" placeholders are LLM-generated in the persona's voice (pooled in the
# background so they appear instantly). This JSON array overrides the built-in fallback list,
# used only while the pool is cold or generation fails. Private chats always show "...".
# TELEGRAM_THINKING_MESSAGES=["hold that thought…","hmm, give me a second…"]
# Optional: chat/group id to receive runtime error logs (uses TELEGRAM_BOT_TOKEN).
# For a group, add the bot to it and use the negative group id (e.g. -1001234567890).
# TELEGRAM_LOG_CHAT_ID=-1001234567890

# Safety (OpenRouter + Gemini models only)
# Set to true to disable Gemini's content safety filters (BLOCK_NONE for all categories)
# DISABLE_SAFETY=true
